# Copy to .env for running the backend without Docker.
# For Docker, use .env.docker.example instead.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat
REDIS_URL=redis://localhost:6379

SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Avatar upload needs real Cloudinary values. Everything else works without them.
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

APP_NAME=Realtime Chat API
APP_VERSION=1.0.0
DEBUG=false

# JSON list
ALLOWED_ORIGINS=["http://localhost:5173"]
