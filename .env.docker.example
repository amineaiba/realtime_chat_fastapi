# Copy to .env.docker and fill in. DATABASE_URL and REDIS_URL are set by
# docker-compose.yml itself (pointing at the postgres/redis services) — don't
# set them here.

SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional for local testing — avatar upload won't work without real values
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

APP_NAME=Realtime Chat API
APP_VERSION=1.0.0
DEBUG=false

ALLOWED_ORIGINS=["http://localhost:5173"]
